<mujoco model="biped 12-dof robot">
  <compiler angle="radian" meshdir="meshes/" autolimits="true"/>

  <option gravity="0 0 -9.81" timestep="0.001"/>

  <statistic center="0 0 0.5" extent="1.0" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-140" elevation="-20"/>
  </visual>

  <asset>
    <mesh name="link0_torso"           file="link0_torso.stl"/>
    <mesh name="left_hip_pitch_link"   file="left_hip_pitch_link.stl"/>
    <mesh name="left_hip_roll_link"    file="left_hip_roll_link.stl"/>
    <mesh name="left_hip_yaw_link"     file="left_hip_yaw_link.stl"/>
    <mesh name="left_knee_link"        file="left_knee_link.stl"/>
    <mesh name="left_ankle_roll_link"  file="left_ankle_roll_link.stl"/>
    <mesh name="left_ankle_pitch_link" file="left_ankle_pitch_link.stl"/>
    <mesh name="right_hip_pitch_link"  file="right_hip_pitch_link.stl"/>
    <mesh name="right_hip_roll_link"   file="right_hip_roll_link.stl"/>
    <mesh name="right_hip_yaw_link"    file="right_hip_yaw_link.stl"/>
    <mesh name="right_knee_link"       file="right_knee_link.stl"/>
    <mesh name="right_ankle_roll_link" file="right_ankle_roll_link.stl"/>
    <mesh name="right_ankle_pitch_link" file="right_ankle_pitch_link.stl"/>

    <texture type="2d" name="groundplane" builtin="checker" mark="random"
        rgb1="0.25 0.3 0.35" rgb2="0.15 0.2 0.25"
        markrgb="0.6 0.7 0.8" width="512" height="512"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="2 2" reflectance="0.05"/>
  </asset>

  <!-- Joint damping matches Pinocchio model (zero) for FK/ID comparison.
       Restore real values once verification is complete. -->
  <default>
    <joint damping="0.0" armature="0.0" frictionloss="0.0"/>
    <geom contype="0" conaffinity="0" group="1" density="0"/>
  </default>

  <contact>
    <pair geom1="floor" geom2="Left_Foot"  solimp="0.9 0.95 0.0001" solref="0.001 1"/>
    <pair geom1="floor" geom2="Right_Foot" solimp="0.9 0.95 0.0001" solref="0.001 1"/>
  </contact>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"
          contype="1" conaffinity="1"/>

    <!-- Pinocchio FK markers (positions overwritten at runtime after mj_forward) -->
    <site name="left_foot_pinocchio"  type="sphere" size="0.04" rgba="0.1 0.9 0.1 0.8" pos="0  0.09 0"/>
    <site name="right_foot_pinocchio" type="sphere" size="0.04" rgba="1.0 0.5 0.0 0.8" pos="0 -0.09 0"/>

    <!-- Floating-base torso — initial height matched to Pinocchio base_z param -->
    <body name="link0_torso" pos="0 0 0.9">
      <joint name="floating_base_joint" type="free" limited="false" actuatorfrclimited="false"/>
      <inertial pos="2.2e-05 1.1e-05 -0.009359" quat="1 0.000109506 -6.05167e-05 -0.000118194"
                mass="5.721" diaginertia="0.1338 0.1019 0.06278"/>
      <geom name="Geom_1" pos="7.79603e-05 0.000318037 0.096917"
            quat="0.999999 -0.000330979 -0.00042909 0.0009936"
            type="mesh" mesh="link0_torso"/>

      <!-- IMU site for sensor readings -->
      <site name="torso_imu" type="box" pos="0.02 0 0.02" size="0.01 0.01 0.01" rgba="1 0 0 1"/>

      <!-- ── Left leg ─────────────────────────────────────────────────────── -->
      <body name="left_hip_pitch_link" pos="0 0.089761 -0.081437" quat="0.991445 -0.130526 0 0">
        <inertial pos="0.005535 0.059218 0.000579" quat="0.54321 0.471468 -0.526254 0.453539"
                  mass="1.764" diaginertia="0.00348919 0.00333912 0.00226469"/>
        <joint name="left_hip_pitch_joint" pos="0 0 0" axis="0 1 0"
               range="-1.0472 1.0472" actuatorfrcrange="-1000 1000"/>
        <geom name="Geom_2" pos="0.00167993 0.0555442 0.000550872"
              quat="0.519286 0.481585 -0.521694 0.475661" type="mesh" mesh="left_hip_pitch_link"/>

        <body name="left_hip_roll_link" pos="0 0.075 0" quat="0.991445 0.130526 0 0">
          <inertial pos="1.6e-05 -0.000136 -0.073241" quat="0.706689 0.00287917 0.00343692 0.70751"
                    mass="1.2918" diaginertia="0.003153 0.00235903 0.00197497"/>
          <joint name="left_hip_roll_joint" pos="0 0 0" axis="1 0 0"
                 range="-0.785398 1.0472" actuatorfrcrange="-1000 1000"/>
          <geom name="Geom_3" pos="0.000168753 -1.79876e-05 -0.0688067"
                quat="0.70714 0.012963 0.0137087 0.706821" type="mesh" mesh="left_hip_roll_link"/>

          <body name="left_hip_yaw_link" pos="0 0 -0.1205">
            <inertial pos="-0.000314 -0.013334 -0.166036" quat="0.726021 -0.0341239 0.0343947 0.685964"
                      mass="1.983" diaginertia="0.012177 0.0116484 0.00198957"/>
            <joint name="left_hip_yaw_joint" pos="0 0 0" axis="0 0 1"
                   range="-0.785398 0.785398" actuatorfrcrange="-1000 1000"/>
            <geom name="Geom_4" pos="-0.000532642 -0.00659485 -0.138083"
                  quat="0.853343 -0.0319929 0.0228041 0.519868" type="mesh" mesh="left_hip_yaw_link"/>

            <body name="left_knee_link" pos="0 0 -0.2035">
              <inertial pos="0.0097 0.003585 -0.164623" quat="0.997864 -0.0268182 -0.0298229 -0.0515561"
                        mass="1.894" diaginertia="0.017253 0.0170683 0.00140868"/>
              <joint name="left_knee_pitch_joint" pos="0 0 0" axis="0 1 0"
                     range="-0.174533 2.0944" actuatorfrcrange="-1000 1000"/>
              <geom name="Geom_5" pos="0.00720688 0.00529163 -0.162386"
                    quat="0.999286 -0.0312041 -0.0196131 0.00825372" type="mesh" mesh="left_knee_link"/>

              <body name="left_ankle_roll_link" pos="0 0 -0.335">
                <inertial pos="0 0 0" quat="0.707107 0.707107 0 0"
                          mass="0.040313" diaginertia="7.009e-06 5.12501e-06 3.4981e-06"/>
                <joint name="left_ankle_roll_joint" pos="0 0 0" axis="1 0 0"
                       range="-0.261799 0.261799" actuatorfrcrange="-1000 1000"/>
                <geom name="Geom_6" pos="7.51834e-09 -3.05311e-09 6.79059e-09"
                      quat="-3.09086e-08 0.707107 3.09086e-08 0.707107"
                      type="mesh" mesh="left_ankle_roll_link"/>

                <body name="left_ankle_pitch_link">
                  <inertial pos="0.029106 0 -0.030483" quat="0.000188682 0.729142 0.000213619 0.684362"
                            mass="0.343229" diaginertia="0.000946586 0.000877 0.000151414"/>
                  <joint name="left_ankle_pitch_joint" pos="0 0 0" axis="0 1 0"
                         range="-0.523599 0.523599" actuatorfrcrange="-1000 1000"/>
                  <geom name="Geom_7" pos="0.0252117 6.09626e-06 -0.0252582"
                        quat="0.000134102 0.74395 -1.09773e-05 0.668236"
                        type="mesh" mesh="left_ankle_pitch_link"/>
                  <!-- Foot contact box -->
                  <geom name="Left_Foot" type="box" size="0.09 0.03 0.006"
                        pos="0.04 0 -0.034" contype="1" conaffinity="1"
                        rgba="0.4 0.4 0.8 0.5" group="3"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ── Right leg ────────────────────────────────────────────────────── -->
      <body name="right_hip_pitch_link" pos="0 -0.089761 -0.081437" quat="0.991445 0.130526 0 0">
        <inertial pos="0.005579 -0.05977 0.000581" quat="0.469823 0.544266 -0.452624 0.527421"
                  mass="1.764" diaginertia="0.00341718 0.00326707 0.00226275"/>
        <joint name="right_hip_pitch_joint" pos="0 0 0" axis="0 1 0"
               range="-1.0472 1.0472" actuatorfrcrange="-1000 1000"/>
        <geom name="Geom_8" pos="0.000859423 -0.0572701 0.000534712"
              quat="0.492136 0.508174 -0.488461 0.510851" type="mesh" mesh="right_hip_pitch_link"/>

        <body name="right_hip_roll_link" pos="0 -0.075 0" quat="0.991445 -0.130526 0 0">
          <inertial pos="1.6e-05 -0.000136 -0.073241" quat="0.706689 0.00287917 0.00343692 0.70751"
                    mass="1.2918" diaginertia="0.003153 0.00235903 0.00197497"/>
          <joint name="right_hip_roll_joint" pos="0 0 0" axis="1 0 0"
                 range="-1.0472 0.610865" actuatorfrcrange="-1000 1000"/>
          <geom name="Geom_9" pos="0.000234252 -6.4135e-06 -0.0688508"
                quat="0.707096 0.0161722 0.0166582 0.706736" type="mesh" mesh="right_hip_roll_link"/>

          <body name="right_hip_yaw_link" pos="0 0 -0.1205">
            <inertial pos="-2.9e-05 0.013844 -0.165473" quat="0.707839 0.0333937 -0.0331595 0.704805"
                      mass="1.983" diaginertia="0.0121706 0.01164 0.00191838"/>
            <joint name="right_hip_yaw_joint" pos="0 0 0" axis="0 0 1"
                   range="-0.785398 0.785398" actuatorfrcrange="-1000 1000"/>
            <geom name="Geom_10" pos="-0.000124317 0.00806157 -0.136323"
                  quat="0.735439 0.0252616 -0.0226934 0.676739" type="mesh" mesh="right_hip_yaw_link"/>

            <body name="right_knee_link" pos="0 0 -0.2035">
              <inertial pos="0.009336 -0.003761 -0.163038" quat="0.998888 0.0287359 -0.0263346 0.0265205"
                        mass="1.879" diaginertia="0.0165702 0.0163813 0.00138847"/>
              <joint name="right_knee_pitch_joint" pos="0 0 0" axis="0 1 0"
                     range="-0.174533 2.0944" actuatorfrcrange="-1000 1000"/>
              <geom name="Geom_11" pos="0.00651264 -0.0053811 -0.160005"
                    quat="0.998421 0.0326769 -0.0142303 -0.0434194" type="mesh" mesh="right_knee_link"/>

              <body name="right_ankle_roll_link" pos="0 0 -0.335">
                <inertial pos="0 0 0" quat="0.707107 0.707107 0 0"
                          mass="0.040313" diaginertia="7.009e-06 5.12501e-06 3.4981e-06"/>
                <joint name="right_ankle_roll_joint" pos="0 0 0" axis="1 0 0"
                       range="-0.261799 0.261799" actuatorfrcrange="-1000 1000"/>
                <geom name="Geom_12" pos="2.67438e-06 7.25847e-07 5.63185e-07"
                      quat="-3.09086e-08 0.707107 3.09086e-08 0.707107"
                      type="mesh" mesh="right_ankle_roll_link"/>

                <body name="right_ankle_pitch_link">
                  <inertial pos="0.029106 0 -0.030483" quat="0.000188682 0.729142 0.000213619 0.684362"
                            mass="0.343229" diaginertia="0.000946586 0.000877 0.000151414"/>
                  <joint name="right_ankle_pitch_joint" pos="0 0 0" axis="0 1 0"
                         range="-0.523599 0.523599" actuatorfrcrange="-1000 1000"/>
                  <geom name="Geom_13" pos="0.0252108 4.67524e-06 -0.0252552"
                        quat="0.000166112 0.743949 1.61954e-05 0.668236"
                        type="mesh" mesh="right_ankle_pitch_link"/>
                  <!-- Foot contact box -->
                  <geom name="Right_Foot" type="box" size="0.09 0.03 0.006"
                        pos="0.04 0 -0.034" contype="1" conaffinity="1"
                        rgba="0.8 0.4 0.4 0.5" group="3"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="left_hip_pitch_m"   joint="left_hip_pitch_joint"   ctrlrange="-200 200"/>
    <motor name="left_hip_roll_m"    joint="left_hip_roll_joint"    ctrlrange="-200 200"/>
    <motor name="left_hip_yaw_m"     joint="left_hip_yaw_joint"     ctrlrange="-100 100"/>
    <motor name="left_knee_m"        joint="left_knee_pitch_joint"  ctrlrange="-200 200"/>
    <motor name="left_ank_roll_m"    joint="left_ankle_roll_joint"  ctrlrange="-50  50"/>
    <motor name="left_ank_pitch_m"   joint="left_ankle_pitch_joint" ctrlrange="-50  50"/>

    <motor name="right_hip_pitch_m"  joint="right_hip_pitch_joint"  ctrlrange="-200 200"/>
    <motor name="right_hip_roll_m"   joint="right_hip_roll_joint"   ctrlrange="-200 200"/>
    <motor name="right_hip_yaw_m"    joint="right_hip_yaw_joint"    ctrlrange="-100 100"/>
    <motor name="right_knee_m"       joint="right_knee_pitch_joint" ctrlrange="-200 200"/>
    <motor name="right_ank_roll_m"   joint="right_ankle_roll_joint" ctrlrange="-50  50"/>
    <motor name="right_ank_pitch_m"  joint="right_ankle_pitch_joint" ctrlrange="-50  50"/>
  </actuator>

  <sensor>
    <framequat     name="torso_quat"  objtype="site" objname="torso_imu"/>
    <accelerometer name="torso_accel" site="torso_imu"/>
    <gyro          name="torso_gyro"  site="torso_imu"/>
  </sensor>

</mujoco>
